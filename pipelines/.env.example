# Copy to pipelines/.env and fill in.
AIRFLOW_UID=50000

# Project DB — defaults to the compose `mysql` service (from your machine: localhost:3307).
# To use a MySQL on your machine instead: mysql+pymysql://user:pw@host.docker.internal:3306/bike_app
MYSQL_ROOT_PASSWORD=bikes
DB_URL=mysql+pymysql://root:bikes@mysql:3306/bike_app

# Analytics warehouse (database `warehouse` in the compose Postgres; host port 5433)
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_DB=warehouse

JCDECAUX_API_KEY=
JCDECAUX_CONTRACT_NAME=dublin
OPENWEATHER_API_KEY=
CITY_NAME=Dublin,IE

# Alert e-mails (src/monitoring/alerts.py). Unset SMTP_HOST = alerts only logged.
# Local testing: `docker compose --profile mail up -d`, view mail at http://127.0.0.1:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=alerts@dublinbikes.local
# Gmail instead: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_STARTTLS=true
#   SMTP_USER=<you>@gmail.com SMTP_PASSWORD=<16-char app password> ALERT_EMAIL_TO=<you>@gmail.com
AIRFLOW_UI_URL=http://127.0.0.1:8080

# Airflow UI login (http://127.0.0.1:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
